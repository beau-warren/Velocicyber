# Copy to .env or run ./velocicyber.sh setup. Never commit .env.
# Leave a key empty to skip that provider. Values are read as data, never executed.
LAMBDA_API=
ADVERSARIAL_API=
# Dataset uploads only; grant write access to your configured datasets. Kept on this device.
HUGGINGFACE_API=
# Optional model downloads: a separate Read token or read-only fine-grained token.
# Verified before GPU use. Never reuse the dataset-upload token. Blank uses anonymous downloads.
HUGGINGFACE_READ_API=

# Optional: needed only while the GitHub repository is private (Contents: read).
GITHUB_API=
